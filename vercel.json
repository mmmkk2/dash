{
  "rewrites": [
    {
      "source": "/andingapp",
      "destination": "https://andingapp.vercel.app/andingapp/"
    },
    {
      "source": "/andingapp/:path*",
      "destination": "https://andingapp.vercel.app/andingapp/:path*"
    },
    {
      "source": "/:page(admin|viewer|login|logout)",
      "destination": "https://andingapp.vercel.app/andingapp/:page"
    },
    {
      "source": "/((?!api/|andingapp|admin|viewer|login|logout).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "claude/**": false
    }
  }
}
